# name: test/sql/shellfs_exit_codes.test
# description: exit status handling for 'command |' reads
# group: [shellfs]

require shellfs

query I
SELECT a FROM read_csv('printf "a\n1\n" |');
----
1

# A non-zero exit status is an error by default
statement error
SELECT a FROM read_csv('printf "a\n1\n"; exit 3 |');
----
Pipe process exited abnormally code=3

# ... unless it is listed in allowed_exit_codes
query I
SELECT a FROM read_csv('printf "a\n1\n"; exit 3 {allowed_exit_codes=3}|');
----
1

query I
SELECT a FROM read_csv('printf "a\n1\n"; exit 3 {allowed_exit_codes=0, 3, 3}|');
----
1

# Listing codes replaces the default of 0
statement error
SELECT a FROM read_csv('printf "a\n1\n" {allowed_exit_codes=1}|');
----
Pipe process exited abnormally code=0

# grep exits with 1 when nothing matches
query I
SELECT count(*) FROM read_csv('(echo a; seq 1 20 | grep 7) {allowed_exit_codes=0,1}|');
----
2

# A command killed by a signal is an error
statement error
SELECT a FROM read_csv('printf "a\n1\n"; kill -TERM $$ |');
----
Pipe process exited with signal signal=15

# Malformed specifications
statement error
SELECT * FROM read_csv('echo 1 {allowed_exit_codes=abc}|');
----
Invalid exit code: 'abc'

statement error
SELECT * FROM read_csv('echo 1 {allowed_exit_codes=}|');
----
No valid exit codes parsed

statement error
SELECT * FROM read_csv('echo 1 {allowed_exit_codes=99999999999}|');
----
Exit code out of range
