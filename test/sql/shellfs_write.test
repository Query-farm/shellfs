# name: test/sql/shellfs_write.test
# description: COPY ... TO '| command' in several formats
# group: [shellfs]

require shellfs

# CSV through a pipe (the destination path must not be treated as a directory)
statement ok
COPY (SELECT range AS n FROM range(5)) TO '| cat > __TEST_DIR__/out.csv' (FORMAT csv, HEADER);

query II
SELECT count(*), sum(n) FROM read_csv('__TEST_DIR__/out.csv');
----
5	10

# The command can transform the data
statement ok
COPY (SELECT range AS n FROM range(100)) TO '| sort -rn | head -3 > __TEST_DIR__/top.csv' (FORMAT csv);

query I
SELECT column0 FROM read_csv('__TEST_DIR__/top.csv', header = false);
----
99
98
97

# Parquet through a pipe
require parquet

statement ok
COPY (SELECT range AS n, range::VARCHAR AS s FROM range(1000)) TO '| cat > __TEST_DIR__/out.parquet' (FORMAT parquet);

query II
SELECT count(*), sum(n) FROM read_parquet('__TEST_DIR__/out.parquet');
----
1000	499500

# The gzip example from the docs: compress in the pipe only, not also in DuckDB
statement ok
COPY (SELECT * FROM range(3) AS t(n)) TO '| gzip > __TEST_DIR__/out.csv.gz' (FORMAT CSV, HEADER, COMPRESSION UNCOMPRESSED);

query I
SELECT n FROM read_csv('__TEST_DIR__/out.csv.gz') ORDER BY n;
----
0
1
2

# ... and the file is compressed exactly once
query I
SELECT n FROM read_csv('gzip -dc __TEST_DIR__/out.csv.gz |') ORDER BY n;
----
0
1
2
