# name: test/sql/shellfs_external_access.test
# description: no shell command runs when enable_external_access is false, even inside allowed_directories
# group: [shellfs]

require shellfs

# POSIX paths and shell syntax
require notwindows

# '/' rather than e.g. '/tmp/', which is a symlink on macOS (DuckDB's own check would then refuse first)
statement ok
SET allowed_directories = ['/'];

statement ok
SET enable_external_access = false;

# DuckDB's allowed_directories check is a prefix match on the path, which this command passes;
# shellfs itself refuses to run it.
statement error
SELECT * FROM read_csv('/x; echo 1 |', header = false);
----
shellfs commands are disabled because enable_external_access is false

statement error
SELECT * FROM read_csv('/ {allowed_exit_codes=0,127}|', header = false);
----
shellfs commands are disabled because enable_external_access is false
