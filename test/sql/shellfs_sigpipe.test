# name: test/sql/shellfs_sigpipe.test
# description: the ignore_sigpipe setting
# group: [shellfs]

require shellfs

# Writing much more than the pipe buffer to a command that exits after the first line.
# By default this is an error (and must not kill the process with SIGPIPE).
statement error
COPY (SELECT * FROM range(1000000)) TO '| head -1 > /dev/null' (FORMAT csv);
----
Broken pipe

statement ok
SET ignore_sigpipe = true;

# With ignore_sigpipe the rest of the output is discarded and the COPY succeeds
statement ok
COPY (SELECT * FROM range(1000000)) TO '| head -1 > {TEST_DIR}/first.csv' (FORMAT csv, HEADER);

query I
SELECT * FROM read_csv('{TEST_DIR}/first.csv', header = false);
----
range

# The command's exit status is still checked
statement error
COPY (SELECT * FROM range(1000000)) TO '| head -1 > /dev/null; exit 4' (FORMAT csv);
----
Pipe process exited abnormally code=4

# Reading only part of a command's output (the command is then terminated by SIGPIPE)
query I
SELECT * FROM read_csv('seq 1 10000000 |') LIMIT 1;
----
1

statement ok
RESET ignore_sigpipe;

query I
SELECT * FROM read_csv('seq 1 10000000 |') LIMIT 1;
----
1

# Commands start with the default SIGPIPE disposition even if the host process ignores SIGPIPE,
# so inside a pipeline 'yes' is terminated by SIGPIPE (status 128 + 13) as it would be in a shell.
query I
SELECT * FROM read_csv('(yes; echo $? > {TEST_DIR}/yes_status) | head -1 > /dev/null; cat {TEST_DIR}/yes_status |', header = false);
----
141

query I
SELECT count(*) FROM read_csv('yes 1 | head -c 100000 |', header = false);
----
50000
